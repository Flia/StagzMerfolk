<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- HUGE KARKING WIP - MOST THINGS ABOUT THIS FOLDER I DO NOT LIKE -->
    
    
    <!-- 
    General lore: tribal tech, but psychically attuned. With Royalty should spawn with psycasters.
    Raid strategy: summons rain/fog. Alt: raid strategy similar to ritual but summons custom weather which does a lot of water or lightning damage + blind smoke + blind fog
    "Merren lore holds that anima trees originated from the deep."
    Probably need to tie in gauranlen too somehow - if only the game had an underwater version of gau
    Unlike normal tribals don't despise ultratech: possibly have a source of it in the deep from ancient terraforming machines or smth
    
    Tempted to go with disney's little mermaid for civil faction and straight up man-eating sirens for hostile faction
    
    wonder if I might *require* nautian, just for the defs unique to that mod
    -->



    <!-- copy-ish of corunan for now. Would just inherit but it has no Name-->
    <CultureDef>
        <defName>Stagz_Aqualan</defName>
        <label>aqualan</label>
        <description>An ancient culture common among water folk.</description>
        <pawnNameMaker>NamerPersonCorunan</pawnNameMaker>
        <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerIdeoCorunan</ideoNameMaker>
        <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerDeityCorunan</deityNameMaker>
        <deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">DeityTypeMakerCorunan</deityTypeMaker>
        <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalCorunan</festivalNameMaker>
        <leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">LeaderTitleMaker_Corunan</leaderTitleMaker>
        <allowedPlaceTags>
            <li>OriginTribal</li>
        </allowedPlaceTags>
        <iconPath>StagzMerfolk/World/WorldObjects/Expanding/MerrenSettlement</iconPath>
        <thingStyleCategories>
            <li MayRequire="GM.Nautian.Style">
                <category>GM_Ocean</category>
                <priority>1</priority>
            </li>
        </thingStyleCategories>
        <styleItemTags>
            <li>
                <tag>Tribal</tag>
                <baseWeight>1</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
            <li>
                <tag>NoBeard</tag>
                <baseWeight>10</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
            <li>
                <tag>BeardTribal</tag>
                <baseWeight>0.3</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
            <li>
                <tag>TattooFaceTribal</tag>
                <baseWeight>0.4</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
            <li>
                <tag>TattooBodyTribal</tag>
                <baseWeight>0.4</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
            <li>
                <tag>NoTattoo</tag>
                <baseWeight>1</baseWeight>
                <weightFactor>1</weightFactor>
            </li>
        </styleItemTags>
    </CultureDef>
    
    
    <!-- 
    Description ideas:
    plenty of fish puns, like pigskins
    -->
    <FactionDef ParentName="TribeBase">
        <defName>Stagz_MerrenCivil</defName>
        <label>gentle merren tribe</label>
        <description>These people have been here a very long time. Maybe their ancestors crashed here a thousand years ago. Maybe they survived some cataclysm that destroyed a technological civilization here. In any case, the tribals are mostly nomadic people who live off the land using primitive tools and weapons.\n\nDespite their apparent technological weakness, the tribals can be dangerous enemies and valuable friends because of their skill with low-tech warfare, their numbers, and their hardiness.\n\nThis particular tribe pursues a gentle way of life where they can. They are quite open to trade and alliances, even with strange peoples.</description>
        <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
        <!-- before orbital traders -->
        <configurationListOrderPriority>79</configurationListOrderPriority>
        <factionIconPath>StagzMerfolk/World/WorldObjects/Expanding/MerrenSettlement</factionIconPath>
        <factionNameMaker>NamerFactionTribal</factionNameMaker>
        <settlementNameMaker>NamerSettlementTribal</settlementNameMaker>
        <!--
        Gonna exclude for now - not a lot of stuffs that fit merren lore
        e.g. most metals should be right out
        -->
        <!--
        <apparelStuffFilter>
            <thingDefs>
                <li>Wood</li>
                <li>Cloth</li>
                <li>Steel</li>
                <li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
                <li>Leather_Lizard</li>
                <li>Leather_Bird</li>
                <li MayRequire="Ludeon.RimWorld.Odyssey">Leather_Sealskin</li>
                <li MayRequire="Ludeon.RimWorld.Odyssey">Leather_Hippo</li>
            </thingDefs>
        </apparelStuffFilter>
        -->
        <allowedCultures Inherit="False">
            <li>Stagz_Aqualan</li>
        </allowedCultures>
        <techLevel>Neolithic</techLevel>
        <colorSpectrum>
            <li>(0, 1, 1)</li>
            <li>(0, 0.6, 1)</li>
            <li>(0.2, 1, 0.6)</li>
            <li>(0.2, 0.8, 1)</li>
            <li>(0.2, 1, 0.8)</li>
        </colorSpectrum>
        <xenotypeSet>
            <xenotypeChances Inherit="False">
                <Stagz_Merfolk_Coastal>0.60</Stagz_Merfolk_Coastal>
                <Stagz_Merfolk_Abyssal>0.40</Stagz_Merfolk_Abyssal>
            </xenotypeChances>
        </xenotypeSet>
        <structureMemeWeights>
            <!-- Those below force styles, weigh 0 disables them. -->
            <!-- Frankly barely a plug for the fact fixedStyle ain't fixing Nautian for me -->
            <Structure_OriginChristian MayRequire="Ludeon.RimWorld.Ideology">0</Structure_OriginChristian>
            <Structure_OriginIslamic MayRequire="Ludeon.RimWorld.Ideology">0</Structure_OriginIslamic>
            <Structure_OriginHindu MayRequire="Ludeon.RimWorld.Ideology">0</Structure_OriginHindu>
            <Structure_OriginBuddhist MayRequire="Ludeon.RimWorld.Ideology">0</Structure_OriginBuddhist>
            <Structure_Animist MayRequire="Ludeon.RimWorld.Ideology">0</Structure_Animist>
        </structureMemeWeights>
        <requiredMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">TreeConnection</li>
        </requiredMemes>
        <disallowedMemes>
            <!-- Merren are friendly -->
            <li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
            <!-- plain don't make sense -->
            <li MayRequire="Ludeon.RimWorld.Ideology">Tunneler</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Shipborn</li>
            <!-- Prevent apparel generation -->
            <li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
            <!-- unclear, but excluded from all vanilla factions, need more testing -->
            <li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
        </disallowedMemes>
        <disallowedPrecepts>
            <!-- Mess with apparel generation -->
            <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Strong_Subordinate</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">ApparelDesired_Soft_Subordinate</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Male_CoveringAnythingButGroinDisapproved</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Nudity_Female_CoveringAnythingButGroinDisapproved</li>
        </disallowedPrecepts>
        <arrivalLayerWhitelist>
            <li>Surface</li>
            <li MayRequire="horizons.deepsea">HDS_Layer_Ocean</li>
        </arrivalLayerWhitelist>
        <layerWhitelist>
            <li>Surface</li> <!-- todo: don't forget to remove -->
            <li MayRequire="horizons.deepsea">HDS_Layer_Ocean</li>
        </layerWhitelist>
        <backstoryFilters>
            <li>
                <categories>
                    <li>Stagz_Coastal</li>
                </categories>
                <commonality>10</commonality>
            </li>
            <li>
                <categories>
                    <li>Tribal</li>
                </categories>
                <commonality>3</commonality>
            </li>
            <li>
                <categories>
                    <li>Outlander</li>
                </categories>
                <commonality>1</commonality>
            </li>
        </backstoryFilters>
        <disallowedRaidStrategies>
            <!-- Same as yttakin, coastals' mining skill is too low to be effective sappers or breachers. Also saves me the trouble of figuring out the groupmaker -->
            <li>ImmediateAttackSappers</li>
            <li>ImmediateAttackBreaching</li>
            <li>ImmediateAttackBreachingSmart</li>
        </disallowedRaidStrategies>
        <pawnGroupMakers Inherit="False">
            <li>
                <!-- Merren should lean to melee -->
                <!-- add some animals, like yttakin raids? -->
                <kindDef>Combat</kindDef>
                <commonality>100</commonality>
                <options>
                    <Stagz_MerrenPenitent>5</Stagz_MerrenPenitent>
                    <Stagz_MerrenWarrior>5</Stagz_MerrenWarrior>
                    <Stagz_MerrenHunter>10</Stagz_MerrenHunter>
                    <Stagz_MerrenChiefRanged>3</Stagz_MerrenChiefRanged>
                    <Stagz_MerrenChiefMelee>1.5</Stagz_MerrenChiefMelee>
                </options>
            </li>
            <li>
                <kindDef>Peaceful</kindDef>
                <options>
                    <Stagz_MerrenWarrior>20</Stagz_MerrenWarrior>
                    <Stagz_MerrenHunter>10</Stagz_MerrenHunter>
                    <!--<Stagz_MerrenChild MayRequire="Ludeon.RimWorld.Biotech">10</Stagz_MerrenChild>-->
                    <Stagz_MerrenChiefRanged>3</Stagz_MerrenChiefRanged>
                    <Stagz_MerrenChiefMelee>1.5</Stagz_MerrenChiefMelee>
                </options>
            </li>
            <li>
                <kindDef>Trader</kindDef>
                <traders>
                    <Stagz_MerrenTrader>1</Stagz_MerrenTrader>
                </traders>
                <carriers> <!-- todo -->
                    <Muffalo>6</Muffalo>
                </carriers>
                <guards>
                    <Stagz_MerrenWarrior>7</Stagz_MerrenWarrior>
                    <Stagz_MerrenHunter>10</Stagz_MerrenHunter>
                </guards>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <Stagz_MerrenWarrior>7</Stagz_MerrenWarrior>
                    <Stagz_MerrenHunter>10</Stagz_MerrenHunter>
                    <Stagz_MerrenChiefRanged>10</Stagz_MerrenChiefRanged>
                    <Stagz_MerrenChiefMelee>10</Stagz_MerrenChiefMelee>
                </options>
            </li>
        </pawnGroupMakers>
    </FactionDef>
</Defs>