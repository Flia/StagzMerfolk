<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- todo: techhediffs budget might be a problem -->
    <!-- pollution and environment as well, for now just turned off -->
    <!-- melee roles weigh toward coastal, ranged/chief toward abyssal -->
    <!-- some tribal stuff should frankly fit - tribal dress, veils -->
    
    <PawnKindDef Name="Stagz_MerrenFactionPawnkindBase" Abstract="True">
        <race>Human</race>
        <defaultFactionDef>Stagz_MerrenCivil</defaultFactionDef>
        <maxGenerationAge>60</maxGenerationAge>
        <chemicalAddictionChance>0.05</chemicalAddictionChance>
        <invNutrition>2.55</invNutrition>
        <apparelTags>
            <li>Stagz_MerrenClothing</li>
        </apparelTags>
        <apparelIgnoreSeasons>true</apparelIgnoreSeasons>
        <apparelIgnorePollution>true</apparelIgnorePollution>
        <invFoodDef>Pemmican</invFoodDef> <!-- todo: algae idea strikes again -->
    </PawnKindDef>

    <PawnKindDef ParentName="Stagz_MerrenFactionPawnkindBase">
        <defName>Stagz_MerrenPenitent</defName>
        <label>penitent</label>
        <combatPower>40</combatPower>
        <chemicalAddictionChance>0.10</chemicalAddictionChance>
        <invNutrition>0</invNutrition>
        <itemQuality>Poor</itemQuality>
        <gearHealthRange>0.2~1.1</gearHealthRange>
        <apparelMoney>0</apparelMoney> <!-- spawn naked -->
        <apparelRequired>
            <li>Apparel_BowlerHat</li>
        </apparelRequired>
        <weaponMoney>200~300</weaponMoney>
        <weaponTags>
            <li>Stagz_MeleeBasic</li>
        </weaponTags>
        <techHediffsMoney>50~50</techHediffsMoney>
        <techHediffsTags>
            <li>Poor</li>
        </techHediffsTags>
        <techHediffsChance>0.15</techHediffsChance>
        <initialWillRange>0~1</initialWillRange>
        <initialResistanceRange>10~17</initialResistanceRange>
    </PawnKindDef>

    <PawnKindDef ParentName="Stagz_MerrenFactionPawnkindBase">
        <defName>Stagz_MerrenWarrior</defName>
        <label>warrior</label>
        <xenotypeSet>
            <xenotypeChances Inherit="False">
                <Stagz_Merfolk_Coastal>0.90</Stagz_Merfolk_Coastal>
                <Stagz_Merfolk_Abyssal>0.10</Stagz_Merfolk_Abyssal>
            </xenotypeChances>
        </xenotypeSet>
        <combatPower>50</combatPower>
        <itemQuality>Poor</itemQuality>
        <canBeSapper>true</canBeSapper>
        <gearHealthRange>0.5~1.8</gearHealthRange>
        <apparelMoney>1000</apparelMoney>
        <apparelRequired>
            <li>Apparel_SimpleHelmet</li>
            <li>Apparel_FlakVest</li>
        </apparelRequired>
        <requiredWorkTags>
            <li>Violent</li>
        </requiredWorkTags>
        <weaponMoney>500</weaponMoney>
        <weaponTags>
            <li>Stagz_MeleeDecent</li>
        </weaponTags>
        <initialWillRange>1~3</initialWillRange>
        <initialResistanceRange>5~9</initialResistanceRange>
    </PawnKindDef>

